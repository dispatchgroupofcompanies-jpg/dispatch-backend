# ===========================================
# IP WHITELIST SECURITY CONFIGURATION
# ===========================================
# Enable IP whitelist enforcement
# Set to "true" to enforce IP whitelist in development mode
# When "true", the ALLOWED_IPS list will be enforced even with npm run dev
# When not set or "false", IP whitelist only enforces in production
# Example: ENABLE_IP_WHITELIST=true
ENABLE_IP_WHITELIST=false

# Comma-separated list of allowed IP addresses
# Only these IPs can access the API when whitelist is enabled
# Example: ALLOWED_IPS=122.161.242.39,192.168.1.100,10.0.0.1
#
# IMPORTANT: 
# - This is REQUIRED when ENABLE_IP_WHITELIST=true or in production
# - Leave empty to block all access when whitelist is enabled
# - Development mode (NODE_ENV !== "production") bypasses this check unless ENABLE_IP_WHITELIST=true
ALLOWED_IPS=122.161.252.39

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
MONGO_URI=mongodb+srv://dispatchgroupofcompanies_db_user:Lollypop3404@cluster0.5yqvu2h.mongodb.net/dispatchgroupofcompanies?retryWrites=true&w=majority&appName=Cluster0

# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=5000
NODE_ENV=production

# ===========================================
# CORS CONFIGURATION
# ===========================================
# Comma-separated list of allowed frontend URLs
FRONTEND_URL=https://your-frontend-domain.vercel.app

# ===========================================
# JWT CONFIGURATION
# ===========================================
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# ===========================================
# OTHER CONFIGURATION
# ===========================================
# Add your other environment variables below